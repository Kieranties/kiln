{
  "name": "kiln",
  "version": "0.0.0-placeholder",
  "private": true,
  "description": "kiln: a personal knowledge and work process built on Obsidian. This package builds and tests kiln's scripts; the plugin is claude-plugin/.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kieranties/kiln.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "0.28.2",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
