{
  "name": "kiln",
  "private": true,
  "description": "Builds and tests kiln. Never published, so it has no version: releases are numbered from version.json (ADR 0006), and the Claude plugin is claude-plugin/.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kieranties/kiln.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "0.28.2",
    "mermaid": "^11.17.2",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
