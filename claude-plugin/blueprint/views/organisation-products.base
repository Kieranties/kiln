filters:
  and:
    - type == "product"
    - list(organisations).contains(this)
properties:
  file.name:
    displayName: Name
  note.kind:
    displayName: Kind
  note.status:
    displayName: Status
  note.summary:
    displayName: Summary
views:
  - type: table
    name: Products
    order:
      - file.name
      - kind
      - status
      - summary
