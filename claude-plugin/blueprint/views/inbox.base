filters:
  and:
    - type == "capture"
    - status == "inbox"
    - not:
        - file.inFolder("_kiln")
properties:
  file.name:
    displayName: Name
  note.captured:
    displayName: Captured
  note.from:
    displayName: From
  note.summary:
    displayName: Summary
views:
  - type: table
    name: Inbox
    order:
      - file.name
      - captured
      - from
      - summary
