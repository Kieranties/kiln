filters:
  and:
    - type == "work"
    - file.hasLink(this.file)
properties:
  file.name:
    displayName: Name
  note.kind:
    displayName: Kind
  note.status:
    displayName: Status
  note.summary:
    displayName: Summary
views:
  - type: table
    name: Work raised
    order:
      - file.name
      - kind
      - status
      - summary
