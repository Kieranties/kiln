filters:
  and:
    - type == "meeting"
    - list(attendees).contains(this)
properties:
  file.name:
    displayName: Name
  note.kind:
    displayName: Kind
  note.summary:
    displayName: Summary
views:
  - type: table
    name: Meetings
    order:
      - file.name
      - kind
      - summary
