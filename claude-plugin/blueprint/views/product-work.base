filters:
  and:
    - type == "work"
    - list(products).contains(this)
properties:
  file.name:
    displayName: Name
  kind:
    displayName: Kind
  status:
    displayName: Status
  summary:
    displayName: Summary
views:
  - type: table
    name: Work
    order:
      - file.name
      - kind
      - status
      - summary
