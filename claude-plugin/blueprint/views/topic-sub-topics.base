filters:
  and:
    - type == "topic"
    - list(topics).contains(this)
properties:
  file.name:
    displayName: Name
  note.status:
    displayName: Status
  note.summary:
    displayName: Summary
views:
  - type: table
    name: Sub-topics
    order:
      - file.name
      - status
      - summary
