{
  "choices": [
    {
      "id": "kiln-capture",
      "name": "Capture to inbox",
      "type": "Template",
      "command": true,
      "templatePath": "_kiln/templates/Capture.md",
      "fileNameFormat": {
        "enabled": true,
        "format": "{{DATE:YYYY-MM-DD}} {{VALUE:title}}"
      },
      "folder": {
        "enabled": true,
        "folders": ["Inbox"],
        "chooseWhenCreatingNote": false,
        "createInSameFolderAsActiveFile": false,
        "chooseFromSubfolders": false
      },
      "appendLink": false,
      "openFile": true,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "mode": "default",
        "focus": true
      },
      "fileExistsBehavior": {
        "kind": "apply",
        "mode": "duplicateSuffix"
      }
    },
    {
      "id": "kiln-log",
      "name": "Log to daily",
      "type": "Capture",
      "command": true,
      "appendLink": false,
      "captureTo": "Daily/{{DATE:YYYY-MM-DD}}.md",
      "captureToActiveFile": false,
      "captureToCanvasNodeId": "",
      "activeFileWritePosition": "cursor",
      "createFileIfItDoesntExist": {
        "enabled": true,
        "createWithTemplate": true,
        "template": "_kiln/templates/Daily.md"
      },
      "format": {
        "enabled": true,
        "format": "- {{DATE:HH:mm}} {{VALUE:Log}}"
      },
      "insertAfter": {
        "enabled": true,
        "after": "## Log",
        "insertAtEnd": true,
        "considerSubsections": false,
        "createIfNotFound": true,
        "createIfNotFoundLocation": "bottom",
        "inline": false,
        "replaceExisting": false,
        "blankLineAfterMatchMode": "auto",
        "promptHeading": false
      },
      "newLineCapture": {
        "enabled": false,
        "direction": "below"
      },
      "prepend": false,
      "task": false,
      "openFile": false,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "mode": "default",
        "focus": true
      },
      "templater": {
        "afterCapture": "none"
      },
      "insertBefore": {
        "enabled": false,
        "before": "",
        "createIfNotFound": false,
        "createIfNotFoundLocation": "top"
      }
    }
  ]
}
